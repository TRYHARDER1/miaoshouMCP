# Supply these as environment variables in your MCP host. This file is an example.
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=
# Alternatively use an AES-256-GCM encrypted secret and a separate Base64 key.
MIAOSHOU_SECRET_ENCRYPTED=
MIAOSHOU_SECRET_KEY=
# Use an absolute JDBC path if the MCP host starts in another directory.
MIAOSHOU_DB_URL=jdbc:sqlite:E:/miaoshouMCP/.data/miaoshou.db
